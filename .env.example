# shoptet-admin MCP – konfigurace. Zkopíruj jako vlastní .env (mimo repozitář) a cestu k němu dej do SHOPTET_ENV_FILE,
# nebo nastav stejné hodnoty jako proměnné prostředí (ty mají přednost). Jeden soubor = jeden e-shop.

# Povinné: adresa e-shopu a přihlášení do jeho administrace (doporučeno samostatný administrátorský účet pro robota)
SHOPTET_ADMIN_URL=https://www.muj-eshop.cz
SHOPTET_ADMIN_USER=robot@muj-eshop.cz
SHOPTET_ADMIN_PASS=

# Volitelné: SFTP účet (admin -> Nastavení -> Hosting -> FTP). Bez něj fungují jen nástroje files_* přes správce souborů.
SHOPTET_SFTP_HOST=ftp.myshoptet.com
SHOPTET_SFTP_USER=
SHOPTET_SFTP_PASS=
# Otisk SSH klíče serveru (SHA-256, admin -> FTP). Výchozí hodnota platí pro ftp.myshoptet.com; při neshodě se server nepřipojí.
# SHOPTET_SFTP_HOST_KEY_SHA256=bNX2DEUrb+uve8s22CVEa8Z1dzLAjUZKQXEpj5wLOxU

# Volitelné: kam ukládat exporty katalogu (výchozí ~/Downloads/shoptet-export)
# SHOPTET_EXPORT_DIR=C:\exporty

# Volitelné: vzdálený režim pro ChatGPT a webové klienty (výchozí stdio pro Claude Code / Claude Desktop)
# SHOPTET_MCP_TRANSPORT=http
# SHOPTET_MCP_HOST=127.0.0.1
# SHOPTET_MCP_PORT=8765
# SHOPTET_MCP_PATH=/                                 # POVINNÉ: lomítko + aspoň 32 náhodných znaků [A-Za-z0-9_-]; bez toho server nenastartuje
# SHOPTET_MCP_TOKEN=                                 # volitelné: klient musí posílat Authorization: Bearer <token> (ChatGPT to neumí, jiní klienti ano)
# SHOPTET_MCP_ALLOWED_HOSTS=muj-tunel.example.com    # hostname tunelu; localhost je povolený vždy, cokoli jiného server odmítne
# SHOPTET_UPLOAD_DIR=C:\shoptet-upload              # ve vzdáleném režimu POVINNÉ: nahrávat a importovat lze jen soubory z této složky
